LIBRARY IEEE;
	use work.all;
	use ieee.std_logic_1164.all;
	use ieee.numeric_std.all;
entity logique_testbench is
end logique_testbench;

architecture arch_logique of logique_testbench is
	
	--component Buzzer_Controle
