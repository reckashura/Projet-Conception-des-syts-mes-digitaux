library IEEE;
use IEEE.STD_LOGIC_1164.ALL;
use IEEE.NUMERIC_STD.ALL;

entity LED_clignotante is
    Port (
        clk : in std_logic;   
	led_in: in std_logic;            
        led_out : out std_logic               
    );
end LED_clignotante;

architecture Bhv_LED of LED_clignotante is
    signal counter : integer := 0;       
    signal led_state : std_logic := '0'; 
    constant clk_freq : integer := 50000000; -- 50MHz
    constant clignotement_intervalle : integer := 1000000; --1 seconde

begin
    process(clk) 
    begin
        if (rising_edge(clk)) then
		if (led_in = '1') then
			counter <= counter + 1;
			if counter = (clk_freq * clignotement_intervalle/1000000) then
				counter <= 0;             
				led_state <= NOT led_state;
			end if;
		else
			counter <= 0;             
                	led_state <= '0';
		end if;
	end if;
    end process;

    led <= led_state;

end Bhv_LED;